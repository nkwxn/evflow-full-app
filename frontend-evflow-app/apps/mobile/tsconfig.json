{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-native",
    "paths": {
      "@evflow/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@evflow/ui": [
        "../../packages/ui/src/index.ts"
      ],
