# Frontend build-time environment. Copy to .env for local development.
# Safe to commit — no real secrets here (frontend values ship in the bundle).

# Which API the web bundle calls:
#   "/"       same-origin (nginx proxies /api/ to the backend) — used in prod
#   full URL  e.g. https://ev-flow-api.opensoft.id for a static-host build
EXPO_PUBLIC_EVFLOW_API_BASE_URL=/

# One-tap demo login password for the quick-access personas. NOT a secret — it
# ships in the bundle and the personas auto-register on the API. Set the same
# value for web and native so the demo works across environments.
EXPO_PUBLIC_DEMO_PASSWORD=evflow-demo-2026

# TomTom traffic overlay. Leave empty and the Live Traffic layer simply does not
# appear; nothing else changes and no request is made.
#
# This value SHIPS IN THE BUNDLE, exactly like the one above. TomTom puts the key
# in the tile URL itself, so anyone using the app can read it. That is normal for
# a tile provider and the control is not secrecy: restrict the key to your
# domains in the TomTom console, and it is useless anywhere else.
EXPO_PUBLIC_TOMTOM_API_KEY=