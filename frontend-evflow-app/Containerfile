# EVFlow web — build the Vite app and serve it with nginx.
# Build:  podman build -t evflow-web:latest -f Containerfile .
#
# VITE_EVFLOW_API_BASE_URL build arg controls which API the bundle calls:
#   "/" (default)  same-origin — nginx proxies /api/ to EVFLOW_API_UPSTREAM
#   full URL       e.g. https://ev-flow-api.opensoft.id for a static-host build
FROM docker.io/library/node:22-alpine AS build

WORKDIR /app

# Workspace manifests first so the npm ci layer caches across source changes.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/features/package.json packages/features/
COPY packages/maps/package.json packages/maps/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN npm ci

COPY . .

ARG VITE_EVFLOW_API_BASE_URL=/
ENV VITE_EVFLOW_API_BASE_URL=$VITE_EVFLOW_API_BASE_URL
# One-tap demo login password, inlined into the bundle at build time. Not a real
# secret (a frontend value always ships in the bundle; the personas auto-register
# on the API) — kept here so the value is configurable per build rather than
# hard-coded in source. Override with --build-arg VITE_DEMO_PASSWORD=... if needed.
ARG VITE_DEMO_PASSWORD=evflow-demo-2026
ENV VITE_DEMO_PASSWORD=$VITE_DEMO_PASSWORD
# TomTom traffic tiles. Empty by default, and an empty value is a supported
# state: tomtomKey() returns null, trafficOverlay() returns null, and the Live
# Traffic row is filtered out of the layer list rather than offering a toggle
# that turns on nothing.
#
# It has to be declared here to reach the build at all. .containerignore excludes
# .env and .env.* on purpose, so a value that only lives in .env works on a
# developer's machine — where Vite reads that file directly — and silently
# vanishes from every built image. That is why Live Traffic had never appeared on
# a deployed build.
#
# Like VITE_DEMO_PASSWORD this is not a secret in the usual sense: a frontend key
# is inlined into the bundle and readable by anyone who opens it. It is billable
# though, so restrict it by domain in the TomTom console rather than relying on
# it being hard to find.
ARG VITE_TOMTOM_API_KEY=
ENV VITE_TOMTOM_API_KEY=$VITE_TOMTOM_API_KEY
RUN npm run build:web

FROM docker.io/library/nginx:1.27-alpine AS runtime

# Where nginx listens and forwards /api/ requests; the nginx image entrypoint
# substitutes these into the config template at container start.
ENV NGINX_LISTEN_PORT=80
ENV EVFLOW_API_UPSTREAM=http://api:8000

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80 8080
