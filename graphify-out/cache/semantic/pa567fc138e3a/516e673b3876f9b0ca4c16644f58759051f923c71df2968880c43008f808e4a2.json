_area_scoring", "target": "ev_planner_study_report_iteration3_data_merged_spklu_footprint", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.1", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_leave_one_city_out_validation", "target": "ev_planner_study_report_iteration3_data_maurya_reference_study", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_iteration_3_data_and_modelling", "target": "ev_planner_study_report_iteration3_data_maurya_reference_study", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.1.7 and 5.3.2", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_predeclared_model_shortlist", "target": "ev_planner_study_report_iteration3_data_utilisation_prediction_target", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2.1", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_training_only_cross_validation", "target": "ev_planner_study_report_iteration3_data_predeclared_model_shortlist", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2.1", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_prediction_ranges", "target": "ev_planner_study_report_iteration3_data_utilisation_prediction_target", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iterat