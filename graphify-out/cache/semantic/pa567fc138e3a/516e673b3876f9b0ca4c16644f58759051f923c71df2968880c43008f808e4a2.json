{"nodes": [{"id": "ev_planner_study_report_iteration3_data_iteration_3_data_and_modelling", "label": "Iteration 3 Data and Modelling", "file_type": "document", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ev_planner_study_report_iteration3_data_common_500_m_spatial_unit", "label": "Common 500 m Spatial Unit", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.1 and 5.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed-size cells make counts comparable across places and avoid the size bias of administrative units such as kelurahan."}, {"id": "ev_planner_study_report_iteration3_data_land_use_features", "label": "Land Use Features", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commercial, residential, and industrial coverages represent distinct charging behaviours; retail is retained but excluded as a standalone model feature because it occurs in only 2.3% of cells."}, {"id": "ev_planner_study_report_iteration3_data_dated_geofabrik_snapshot", "label": "Dated Geofabrik Java Snapshot", "file_type": "rationale", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dated snapshot is preferred to the rolling latest file so extraction can be repeated and audited."}, {"id": "ev_planner_study_report_iteration3_data_road_connectivity_features", "label": "Road Connectivity Features", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connectivity is treated as a first-class demand proxy because reachable stations are more useful and connectivity was among the reference study's strongest predictors."}, {"id": "ev_planner_study_report_iteration3_data_indonesian_poi_schema", "label": "Indonesian Point-of-Interest Schema", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thirteen categories mirror the reference study for comparability, while fuel stations, malls, hospitals, and highway rest areas are added to reflect Indonesian siting practice under Kepmen ESDM 24.K/2025."}, {"id": "ev_planner_study_report_iteration3_data_bps_calibrated_worldpop", "label": "BPS-Calibrated WorldPop Population", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The constrained 2026 projection avoids distributing residents into unbuilt land and is calibrated to official BPS projections to anchor modelled cell values to administrative totals."}, {"id": "ev_planner_study_report_iteration3_data_p_code_statistical_bridge", "label": "P-Code Statistical Bridge", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing the country prefix from HDX P-codes yields BPS kode wilayah, providing a reliable join between official statistics and map geometry."}, {"id": "ev_planner_study_report_iteration3_data_boundary_derived_area_labels", "label": "Boundary-Derived Area Labels", "file_type": "rationale", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.1.5 and 5.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spatial containment replaces inconsistent free-text province and city fields and removes spelling errors inherited from station feeds."}, {"id": "ev_planner_study_report_iteration3_data_merged_spklu_footprint", "label": "Merged SPKLU Station Footprint", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.1.6 and 5.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ev_planner_study_report_iteration3_data_75_m_cross_source_deduplication", "label": "75 m Cross-Source Deduplication", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records within 75 metres are merged to prevent the same physical station from being counted multiple times; PLN is preferred on disagreement while contributing sources remain recorded."}, {"id": "ev_planner_study_report_iteration3_data_station_label_repair", "label": "Station Label Repair", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing an OSM-only label containing 19 positive cells with the merged three-source footprint containing 889 positive cells made supervised learning viable without changing methodology."}, {"id": "ev_planner_study_report_iteration3_data_stage_a_underserved_area_scoring", "label": "Stage A Underserved-Area Scoring", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboard-controlled weights keep recommendations inspectable, while the distance-only prototype is treated as mechanism validation rather than siting advice."}, {"id": "ev_planner_study_report_iteration3_data_maurya_reference_study", "label": "Maurya et al. Reference Study", "file_type": "paper", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.1.7 and 5.3.2", "source_url": null, "captured_at": null, "author": "Maurya et al.", "contributor": null}, {"id": "ev_planner_study_report_iteration3_data_leave_one_city_out_validation", "label": "Leave-One-City-Out Validation", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holding out whole cities tests transfer to unseen geography more honestly than a random split."}, {"id": "ev_planner_study_report_iteration3_data_utilisation_prediction_target", "label": "Utilisation Prediction Target", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model predicts transaction counts rather than station presence to avoid reproducing PLN's institutional siting pattern as if it represented customer demand."}, {"id": "ev_planner_study_report_iteration3_data_predeclared_model_shortlist", "label": "Predeclared Model Shortlist", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Negative binomial, ridge, elastic net, shallow random forest, and shallow gradient boosting are compared against simple baselines; neural networks are excluded because 139 examples cannot support them."}, {"id": "ev_planner_study_report_iteration3_data_training_only_cross_validation", "label": "Training-Only Cross-Validation Selection", "file_type": "rationale", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model selection is performed only within training data, and the simplest model within one standard error of the best is preferred to avoid optimistic held-out results and unjustified complexity."}, {"id": "ev_planner_study_report_iteration3_data_prediction_ranges", "label": "Prediction Ranges", "file_type": "rationale", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.3.2.1 and 5.3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every prediction is reported as a range because a dataset of 139 labelled sites cannot justify bare point estimates."}, {"id": "ev_planner_study_report_iteration3_data_stage_c_feasibility_and_financials", "label": "Stage C Feasibility and Financial Analytics", "file_type": "concept", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legal, physical, and electrical constraints act as exclusion gates rather than score penalties, and financial return is withheld until supported by real usage."}, {"id": "ev_planner_study_report_iteration3_data_simulated_usage_financial_guardrail", "label": "Simulated-Usage Financial Guardrail", "file_type": "rationale", "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Sections 5.3.3 and 5.3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated usage remains marked as simulated and may support driver features, but no financial figure may be calculated from it; planners must enter income assumptions explicitly until measured usage exists."}], "edges": [{"source": "ev_planner_study_report_iteration3_data_iteration_3_data_and_modelling", "target": "ev_planner_study_report_iteration3_data_common_500_m_spatial_unit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_land_use_features", "target": "ev_planner_study_report_iteration3_data_common_500_m_spatial_unit", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.1", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_dated_geofabrik_snapshot", "target": "ev_planner_study_report_iteration3_data_land_use_features", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.1", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_road_connectivity_features", "target": "ev_planner_study_report_iteration3_data_common_500_m_spatial_unit", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.2", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_indonesian_poi_schema", "target": "ev_planner_study_report_iteration3_data_maurya_reference_study", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ev-planner-study/report_iteration3_data.md", "source_location": "Section 5.1.3", "weight": 1.0}, {"source": "ev_planner_study_report_iteration3_data_bps_calibrated_worldpop", "target": "ev_planner_study_report_iteration3_data_p_code_statistical_bridge", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, 